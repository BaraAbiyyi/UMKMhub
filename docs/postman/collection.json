{
  "info": {
    "name": "UMKMHub API v2 (Marketplace Simulasi)",
    "description": "Koleksi Postman UMKMHub v2. Jalankan request login untuk menyimpan token ke variabel koleksi. Variabel id perlu disesuaikan dengan data hasil seeder. Semua pembayaran bersifat simulasi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "superadmin_email",
      "value": "superadmin@umkmhub.id",
      "type": "string"
    },
    {
      "key": "umkm_email",
      "value": "sari@umkmhub.id",
      "type": "string"
    },
    {
      "key": "customer_email",
      "value": "dimas@gmail.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password123",
      "type": "string"
    },
    {
      "key": "store_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "stock_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "cart_item_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "address_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autentikasi",
      "item": [
        {
          "name": "POST Registrasi pengguna baru (Pembeli / Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registrasi pengguna baru (Pembeli / Customer)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sari Rahayu\",\n  \"email\": \"sari@umkmhub.id\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST Login untuk semua peran (Superadmin, Admin UMKM, Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login untuk semua peran (Superadmin, Admin UMKM, Customer)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sari@umkmhub.id\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.access_token) {",
                  "    pm.collectionVariables.set('token', body.data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Logout dan hapus token aktif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Logout dan hapus token aktif"
          }
        },
        {
          "name": "GET Profil pengguna yang sedang terautentikasi",
