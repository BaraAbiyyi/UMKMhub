# =============================================================
# APLIKASI
# =============================================================

APP_NAME=UMKMHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Locale & Faker
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Mode maintenance
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Jumlah worker CLI server bawaan PHP (opsional, uncomment jika perlu)
# PHP_CLI_SERVER_WORKERS=4

# Bobot hash bcrypt untuk password (12 = default produksi; gunakan 4 saat testing)
BCRYPT_ROUNDS=12

# =============================================================
# LOGGING
# =============================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Gunakan 'error' di production untuk mengurangi volume log
LOG_LEVEL=debug

# =============================================================
# DATABASE
# =============================================================

# Driver default: sqlite (tidak perlu server database tambahan untuk dev lokal)
# Untuk MySQL/PostgreSQL di production, gunakan nilai di bawah ini
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=umkmhub
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================
# SESSION
# =============================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================
# BROADCAST / REAL-TIME
# =============================================================

BROADCAST_CONNECTION=log

# =============================================================
# FILESYSTEM / STORAGE
# =============================================================

# Disk default untuk penyimpanan file unggahan (local, public, s3)
FILESYSTEM_DISK=local

# =============================================================
# QUEUE
# =============================================================

# Driver antrean background job
QUEUE_CONNECTION=database

# =============================================================
# CACHE
# =============================================================

CACHE_STORE=database
# CACHE_PREFIX=

# =============================================================
# MEMCACHED (opsional — aktifkan jika menggunakan Memcached)
# =============================================================

MEMCACHED_HOST=127.0.0.1

# =============================================================
# REDIS (opsional — aktifkan jika menggunakan Redis untuk cache/queue/session)
# =============================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================
# MAIL
# =============================================================

# Gunakan 'log' untuk dev lokal (email ditulis ke log, tidak terkirim)
# Gunakan 'smtp' untuk produksi
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@umkmhub.id"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================
# AWS S3 (opsional — aktifkan jika menggunakan S3 untuk penyimpanan file)
# =============================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================
# VITE (frontend)
# =============================================================

VITE_APP_NAME="${APP_NAME}"
